# ==============================================================================
# GALUR - Konfigurasi Lingkungan (Environment Variables)
# ==============================================================================

# 1. Supabase Project URL (Dapatkan dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (Dapatkan dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================================================
# CATATAN GOOGLE OAUTH & DATABASE RLS:
# ==============================================================================
# 1. Jalankan skrip 'supabase_setup.sql' di SQL Editor Supabase untuk membuat tabel 'diagrams' dengan Row Level Security (RLS).
# 2. Di Supabase Dashboard -> Authentication -> Providers -> Google:
#    - Masukkan Google Client ID & Client Secret dari Google Cloud Console.
#    - Tambahkan Redirect URL: https://<project-id>.supabase.co/auth/v1/callback
# 3. Di Vercel Dashboard -> Project Settings -> Environment Variables:
#    - Tambahkan NEXT_PUBLIC_SUPABASE_URL dan NEXT_PUBLIC_SUPABASE_ANON_KEY.
